#!/bin/sh
#
# PROVIDE: e1desktop
# REQUIRE: dbus DAEMON
# KEYWORD: nojail shutdown
#
# Start the desktop selected in /etc/e1desk:
#   e1wm-workstation / e1wm-mobile -> e1wm directly on ttyv0
#   mate / xfce / gershwin         -> LightDM
#

. /etc/rc.subr

name="e1desktop"
rcvar="e1desktop_enable"
load_rc_config $name
: ${e1desktop_enable:=NO}

pidfile="/var/run/e1desktop.pid"
command_interpreter="none"

e1desktop_start() {
    desk=$(cat /etc/e1desk 2>/dev/null)
    case "$desk" in
    e1wm-workstation|e1wm-mobile)
        if [ "$desk" = "e1wm-mobile" ]; then
            echo mobile > /etc/e1mode
        else
            echo workstation > /etc/e1mode
        fi
        echo "Starting e1wm on ttyv0 ($desk)"
        setsid sh -c 'exec /usr/local/sbin/e1wm </dev/ttyv0 >/dev/ttyv0 2>&1' &
        echo $! > "$pidfile"
        ;;
    mate|xfce|gershwin)
        echo "Starting LightDM (session: $desk)"
        # rc-time PATH lacks /usr/local/bin where the X server wrapper lives.
        PATH="/usr/local/bin:/usr/local/sbin:$PATH"

        # Live media / is read-only; mount writable tmpfs overlays for the
        # caches that GTK and LightDM need (schemas, fontconfig, pixbuf
        # loaders, icon themes).
        if mount -p | awk '$2 == "/" { exit !($1 ~ /^\/dev\/iso9660\// || $1 ~ /^\/dev\/cd/) }'; then
            kldload tmpfs 2>/dev/null
            mkdir -p /tmp/liveoverlay

            for d in \
                /usr/local/share/glib-2.0/schemas \
                /usr/local/etc/fonts \
                /usr/local/lib/gdk-pixbuf-2.0 \
                /usr/local/share/icons/hicolor \
                /usr/local/share/icons/AdwaitaLegacy \
                /usr/local/share/mime \
                /var/lib/lightdm-data \
                ; do
                mkdir -p "/tmp/liveoverlay$d"
                cp -R "$d/." "/tmp/liveoverlay$d/" 2>/dev/null
                mount -t tmpfs -o rw tmpfs "$d" 2>/dev/null
                cp -R "/tmp/liveoverlay$d/." "$d/" 2>/dev/null
            done

            # Compile schemas and update caches in the writable overlays.
            glib-compile-schemas /usr/local/share/glib-2.0/schemas/ 2>/dev/null
            fc-cache -f 2>/dev/null
            gdk-pixbuf-query-loaders --update-cache 2>/dev/null
            gtk-update-icon-cache -f /usr/local/share/icons/hicolor 2>/dev/null
            gtk-update-icon-cache -f /usr/local/share/icons/AdwaitaLegacy 2>/dev/null
            gtk-update-icon-cache -f /usr/local/share/icons/Adwaita 2>/dev/null
            update-mime-database /usr/local/share/mime 2>/dev/null
        fi

        exec /usr/local/sbin/lightdm
        ;;
    *)
        echo "e1desktop: unknown desktop '$desk' in /etc/e1desk"
        return 1
        ;;
    esac
}

e1desktop_stop() {
    pkill -x e1wm 2>/dev/null
    pkill -x lightdm 2>/dev/null
    rm -f "$pidfile"
}

start_cmd=e1desktop_start
stop_cmd=e1desktop_stop
run_rc_command "$1"
